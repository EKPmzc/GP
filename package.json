{
  "name": "mosaic-studio-desktop",
  "version": "2.0.0",
  "description": "Desktop mosaic/glitch studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . MosaicStudio --platform=darwin,win32,linux",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "make:launcher": "powershell -ExecutionPolicy Bypass -File tools/make-launcher.ps1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "27.1.0",
    "electron-builder": "24.6.4"
  },
  "build": {
    "appId": "com.mosaicstudio.desktop",
    "productName": "Mosaic Studio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "tools/win-launcher.bat"
    ],
    "extraResources": [
      {
        "from": "tools/win-launcher.bat",
        "to": "win-launcher.bat"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
